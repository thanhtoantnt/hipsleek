# dune
_build/
*.exe

# mona is vendored in-tree (mona-1.4/); ignore only runtime/build outputs
mona.failure
/mona_predicates.mona
*.omega
mona-1.4/config.h

# external tools cloned/built by CI
fixcalc_src/
omega_stub/

# omega vendored tree builds in-place; obj/ holds only artifacts + tracked
# makefiles (generated parser files are untracked, rebuilt from parser.y)
omega_modified/*/obj/*
!omega_modified/*/obj/Makefile*
!omega_modified/*/obj/parser.y

# scratch
.envrc
logs/
*.log
